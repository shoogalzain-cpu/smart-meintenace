<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_maintenance_plans" model="ir.cron">
        <field name="name">Maintenance: preventive plans due or overdue</field>
        <field name="model_id" ref="model_maintenance_plan"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_maintenance_plans()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_maintenance_overdue_requests" model="ir.cron">
        <field name="name">Maintenance: notify managers of overdue requests</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_overdue_requests()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
